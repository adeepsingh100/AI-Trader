# Client-side Firebase config — not secret, safe to expose (Firebase's
# security model is Firestore rules + server-side session verification,
# not hiding these values). project ai-bot-14723.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=

# Server-side only — the whole service-account key JSON file's contents
# as one value, same as the Python bot's FIREBASE_SERVICE_ACCOUNT_JSON.
FIREBASE_SERVICE_ACCOUNT_JSON=
