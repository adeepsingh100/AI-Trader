ce_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "src_agents_execution_paper_paperexecutionagent", "label": "PaperExecutionAgent (src/agents/execution/paper.py)", "file_type": "code", "source_file": "PROJECT_SPEC.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "src_agents_execution_real_realexecutionagent", "label": "RealExecutionAgent (src/agents/execution/real.py)", "file_type": "code", "source_file": "PROJECT_SPEC.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "src_agents_data_agent_module", "label": "Data Agent (src/agents/data_agent.py)", "file_type": "code", "source_file": "PROJECT_SPEC.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "src_agents_signal_agent_module", "label": "Signal Agent (src/agents/signal_agent.py)", "file_type": "code", "source_file": "PROJECT_SPEC.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "src_agents_reporting_agent_module", "label": "Reporting Agent (src/agents/reporting_agent.py)", "file_type": "code", "source_file": "PROJECT_SPEC.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "project_spec_capital_config", "label": "capital_config table", "file_type": "concept", "source_file": "PROJECT_SPEC.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "project_spec_strategy_versions", "label": "strategy_versions table", "file_type": "concept", "source_file": "PROJECT_SPEC.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "project_spec_trades", "label": "trades table", "file_type": "concept", "source_file": "PROJECT_SPEC.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "project_spec_daily_pnl", "label": "daily_pnl table", "file_type": "concept", "source_file": "PROJECT_SPEC.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "project_spec_agent_logs", "label": "agent_logs table", "file_type": "concept", "source_file": "PROJECT_SPEC.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "project_spec_model_usage", "label": "model_usage table", "file_type": "concept", "source_file": "PROJECT_SPEC.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "project_spec_circuit_breaker", "label": "Daily Max-Loss Circuit Breaker", "file_type": "rationale", "source_file": "PROJECT_SPEC.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Daily max-loss is a hard circuit breaker, not a guarantee: once realized loss hits max_daily_loss the bot stops opening new positions and flattens all open positions immediately; this only bounds realized loss to approximately the threshold plus flattening slippage since markets can gap and orders can fail. Stays blocked until the next IST trading day."}, {"id": "project_spec_position_sizing_rule", "label": "Fixed % Position Sizing Rule", "file_type": "rationale", "source_file": "PROJECT_SPEC.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Fixed % of capital_to_use per trade (position_size_pct, default 10%), capped at max_concurrent_positions (default 5) simultaneous positions. At defaults, at most 50% of allocated capital is deployed at once \u2014 a deliberate buffer, not a hard requirement."}, {"id": "project_spec_promotion_criteria", "label": "Real-Trading Promotion Criteria", "file_type": "rationale", "source_file": "PROJECT_SPEC.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Configurable via env vars rather than a DB table because these change rarely and don't need versioning: PROMOTION_MIN_PAPER_DAYS (default 14), PROMOTION_MIN_CUMULATIVE_PNL (default 0), PROMOTION_MAX_DRAWDOWN_PCT (default 15). Evolution Agent checks these against the current paper version and sets promoted_to_real when met."}, {"id": "project_spec_stop_loss_take_profit", "label": "Stop-Loss/Take-Profit Polling Enforcement", "file_type": "rationale", "source_file": "PROJECT_SPEC.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Per-trade stop_loss_pct/take_profit_pct from the active strategy version's params_json are enforced against live ticker price independent of the LLM signal. Not a guarantee: CoinDCX's spot API has no exchange-side stop order (stop-limit/take-profit exist only in the margin product, deliberately unused), so enforcement is by polling (risk_check.yml, every 5 min) rather than exchange-side watching; GitHub Actions free-tier cron is best-effort so the actual gap can exceed 5 minutes, and a fast move can realize a loss/gain past the configured percentage before the next check. An always-on poller would close this gap but is a deliberate scope decision not taken."}, {"id": "project_spec_llm_provider_abstraction", "label": "LLM Provider Abstraction (Groq/Ollama fallback chain)", "file_type": "rationale", "source_file": "PROJECT_SPEC.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Provider is configurable (LLM_PROVIDER=groq default or ollama via Ollama Cloud); groq_client.py's chat() is the single entry point both Signal and Evolution agents call with the same retry/fallback/logging behavior either way, so switching providers is an env var change, not a code change. On 429/error: exponential backoff on the current model, then fallback to the next model in the configurable GROQ_MODEL_CHAIN/OLLAMA_MODEL_CHAIN, logging every attempt to model_usage. Verified during build by forcing a failure to confirm the fallback chain actually triggers, rather than trusting the retry logic unexercised."}, {"id": "project_spec_fee_model", "label": "Paper Trading Fee/Slippage Simulation Model", "file_type": "rationale", "source_file": "PROJECT_SPEC.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Paper execution simulates fills against live orderbook data with configurable slippage (bps against best bid/ask) and mirrors CoinDCX's real fee schedule: 0.5% trading fee on trade value both sides, +18% GST on that fee, plus 1% TDS (Income Tax Act s.194S) on trade value on sells only \u2014 so paper PnL stays directly comparable to real trading. Constants live in paper.py for adjustment if CoinDCX's schedule changes."}, {"id": "project_spec_real_trading_gate", "label": "promoted_to_real Gate", "file_type": "rationale", "source_file": "PROJECT_SPEC.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Real trading only ever runs a strategy_versions.promoted_to_real = true version. The gate lives in the orchestrator (not just the execution agent) so there is no path that reaches real order placement with an unpromoted strategy. RealExecutionAgent adds the same 1% sell-side TDS on top of the exchange-reported fee since TDS isn't a documented response field \u2014 unverified against a real fill because account balance was under CoinDCX's \u20b9100 min_notional at build time."}, {"id": "project_spec_deployment_topology", "label": "Free-Tier Deployment Topology", "file_type": "rationale", "source_file": "PROJECT_SPEC.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Free-tier-only: GitHub Actions cron for trading_cycle (*/10 min), risk_check (*/5 min, GH Actions' shortest interval), and evolution (nightly) workflows invoking the same orchestrator/evolution_agent scripts used locally; Supabase free-tier Postgres for storage; Vercel-hosted Next.js dashboard reading Supabase directly via a read-only anon key + RLS, no separate backend server. GitHub Actions cron is best-effort, not guaranteed \u2014 runs can be delayed under platform load, so daily bookkeeping recomputes from trades/daily_pnl rather than trusting cycle count."}, {"id": "project_spec_daily_rollover_ist", "label": "Midnight IST Daily Rollover", "file_type": "concept", "source_file": "PROJECT_SPEC.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "project_spec_row_level_security", "label": "Supabase Row-Level Security (RLS)", "file_type": "concept", "source_file": "PROJECT_SPEC.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "project_spec_dashboard_nextjs", "label": "Dashboard (Next.js on Vercel)", "file_type": "concept", "source_file": "PROJECT_SPEC.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "project_spec_multi_agent_architecture", "label": "Multi-Agent Architecture (one cycle, run-to-completion)", "file_type": "rationale", "source_file": "PROJECT_SPEC.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "All agents are separate, independently testable Python modules under src/agents/. One full cycle (data \u2192 signal \u2192 risk \u2192 execute \u2192 log) runs to completion and exits \u2014 no long-running process, since GH Actions free-tier cron re-invokes the script each interval instead of keeping a daemon alive."}, {"id": "project_spec_paper_trading", "label": "Paper Trading mode", "file_type": "concept", "source_file": "PROJECT_SPEC.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "project_spec_real_trading", "label": "Real Trading mode", "file_type": "concept", "source_file": "PROJECT_SPEC.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "project_spec_build_order", "label": "11-Step Build Order", "file_type": "concept", "source_file": "PROJECT_SPEC.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "project_spec_document", "label": "PROJECT_SPEC.md", "file_type": "document", "source_file": "PROJECT_SPEC.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "src_orchestrator_module", "target": "src_agents_data_agent_module", "relation": "calls", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "PROJECT_SPEC.md", "source_location": null, "weight": 1.0}, {"source": "src_orchestrator_module", "target": "src_agents_signal_agent_module", "relation": "calls", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "PROJECT_SPEC.md", "source_location": null, "weight": 1.0}, {"source": "src_orchestrator_module", "target": "src_agents_risk_manager_module", "relation": "calls", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "PROJECT_SPEC.md", "source_location": null, "weight": 1.0}, {"source": "src_orchestrator_module", "target": "src_agents_execution_paper_paperexecutionagent", "relation": "calls", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "PROJECT_SPEC.md", "source_location": null, "weight": 1.0}, {"source": "src_orchestrator_module", "target": "src_agents_execution_real_realexecutionagent", "relation": "calls", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "P