# LLM provider: "groq" (default) or "ollama" (Ollama Cloud, not local)
LLM_PROVIDER=groq

# Groq
GROQ_API_KEY=
GROQ_MODEL_CHAIN=openai/gpt-oss-120b,qwen/qwen3.6-27b

# Ollama Cloud — only used when LLM_PROVIDER=ollama. Get a key at
# https://ollama.com/settings/keys. Model names from
# https://ollama.com/search?c=cloud — no "-cloud" suffix here: that
# suffix is only for routing through a local Ollama daemon, not this
# direct-to-ollama.com setup (see https://docs.ollama.com/cloud#python).
OLLAMA_API_KEY=
OLLAMA_BASE_URL=https://ollama.com
OLLAMA_MODEL_CHAIN=gpt-oss:120b

# CoinDCX
COINDCX_API_KEY=
COINDCX_API_SECRET=

# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_ANON_KEY=

# Promotion criteria (paper -> real), see PROJECT_SPEC.md §2
PROMOTION_MIN_PAPER_DAYS=14
PROMOTION_MIN_CUMULATIVE_PNL=0
PROMOTION_MAX_DRAWDOWN_PCT=15
