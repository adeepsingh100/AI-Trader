# LLM: Groq first, auto-falling back to Gemini if the whole Groq chain
# fails — no provider-select var. Not used by live trading (100% quant,
# zero LLM calls) — the only caller is the hourly, code-validated
# exit-params proposal step (src/learning/recommendations.py::
# generate_ai_exit_params_recommendations).
GROQ_API_KEY=
GROQ_MODEL_CHAIN=openai/gpt-oss-120b,qwen/qwen3.6-27b
GEMINI_API_KEY=
GEMINI_MODEL_CHAIN=gemini-2.5-flash

# Per-model retry (before falling to the next model in the chain above)
LLM_MAX_RETRIES_PER_MODEL=2
LLM_BACKOFF_BASE_SECONDS=1.0

# CoinDCX
COINDCX_API_KEY=
COINDCX_API_SECRET=

# Neon (Postgres) — pooled connection string, used by src/db/models.py at
# runtime. DATABASE_URL_UNPOOLED is not read by any code here; it's only
# for manual psql/pg_dump work (schema migrations) against the direct
# connection string, never the pooled one. Mid-migration off Neon onto
# Firebase/Firestore (see models.py's module docstring) — still required
# for every table not yet on its own migration phase.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Firebase (Firestore) — the whole service-account key JSON file's
# contents as one value (not a file path), project ai-bot-14723. Get one:
# Firebase Console -> Project Settings -> Service Accounts -> Generate
# new private key.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Promotion criteria (paper -> real), see PROJECT_SPEC.md §2
PROMOTION_MIN_PAPER_DAYS=14
PROMOTION_MIN_CUMULATIVE_PNL=0
PROMOTION_MAX_DRAWDOWN_PCT=15

# Promotion Gate (src/learning/promotion_gate.py, PROJECT_SPEC.md §3e) —
# multi-dimensional, evidence-gated auto-promotion. Stays fully automatic;
# missing required evidence (e.g. no historical candles ingested for
# walk-forward/champion-challenger) always yields EXTEND_VALIDATION, never
# a silent skip or a promotion on partial evidence.
PROMOTION_MIN_BACKTEST_TRADES=1000
PROMOTION_MIN_WALK_FORWARD_TRADES=300
PROMOTION_MIN_PAPER_TRADES=300
# Two distinct counts: matched (champion, challenger) snapshots (shared
# decision-cycle timestamp, never min(champion_trades, challenger_trades))
# vs. the one-fewer paired RETURN observations (consecutive-snapshot
# deltas) the statistical significance gate actually consumes.
PROMOTION_MIN_PAIRED_SNAPSHOTS=200
PROMOTION_MIN_PAIRED_RETURN_OBSERVATIONS=200
# Moving Block Bootstrap block length (contiguous paired-return points per
# resampled block) — preserves local temporal dependence a plain
# point-wise bootstrap would destroy.
PROMOTION_BOOTSTRAP_BLOCK_LENGTH=5
PROMOTION_MC_MIN_PROFITABLE_PCT=70
PROMOTION_MC_MAX_CATASTROPHIC_DD_PROBABILITY_PCT=5
PROMOTION_MC_CATASTROPHIC_DD_THRESHOLD_PCT=25
PROMOTION_MC_MAX_WORST_DRAWDOWN_PCT=25
PROMOTION_MAX_REGIME_DEGRADATION_PCT=30
PROMOTION_MAX_SYMBOL_PROFIT_CONCENTRATION_PCT=60
PROMOTION_MIN_PROFITABLE_SYMBOLS=2
PROMOTION_MIN_SHARPE_IMPROVEMENT_PCT=10
PROMOTION_MIN_EXPECTANCY_IMPROVEMENT_PCT=5
PROMOTION_MAX_DRAWDOWN_INCREASE_PCT=0
# Minimum bootstrap_probability_candidate_better_pct (% of Moving Block
# Bootstrap resamples of the paired candidate-minus-champion return series
# whose cumulative difference is positive) — NOT a generic "confidence".
PROMOTION_MIN_CONFIDENCE_PCT=95
PROMOTION_COOLDOWN_DAYS=7
# Promotion Score weights — renormalized among available components;
# necessary but never sufficient, every hard gate above must ALSO pass.
PROMOTION_SCORE_WEIGHT_OUT_OF_SAMPLE=0.20
PROMOTION_SCORE_WEIGHT_CHAMPION_IMPROVEMENT=0.20
PROMOTION_SCORE_WEIGHT_RISK=0.20
PROMOTION_SCORE_WEIGHT_STATISTICAL_SIGNIFICANCE=0.15
PROMOTION_SCORE_WEIGHT_REGIME_ROBUSTNESS=0.10
PROMOTION_SCORE_WEIGHT_EXECUTION_QUALITY=0.05
PROMOTION_SCORE_WEIGHT_STABILITY=0.05
PROMOTION_SCORE_WEIGHT_SIMPLICITY=0.05
PROMOTION_MIN_SCORE=70

# Feature Engine / Opportunity Scorer (quant-first pipeline, see
# PROJECT_SPEC.md §3) — all optional, these are the defaults.
TIMEFRAME_WEIGHTS=1m:0.15,15m:0.25,1h:0.30,1d:0.30
FEATURE_CANDLE_LIMIT=250
RSI_PERIOD=14
MACD_FAST=12
MACD_SLOW=26
MACD_SIGNAL=9
STOCH_RSI_PERIOD=14
STOCH_K_SMOOTH=3
STOCH_D_SMOOTH=3
ATR_PERIOD=14
BOLLINGER_PERIOD=20
BOLLINGER_NUM_STD=2
RELATIVE_VOLUME_LOOKBACK=20
VOLUME_SPIKE_THRESHOLD=2.0
OBV_SLOPE_LOOKBACK=5
SUPPORT_RESISTANCE_LOOKBACK=50
ADX_PERIOD=14
EMA_TREND_PERIOD_1=20
EMA_TREND_PERIOD_2=50
EMA_TREND_PERIOD_3=100
EMA_TREND_PERIOD_4=200
RSI_SCORE_FLOOR=30
RSI_SCORE_CEIL=70
STOCH_RSI_SCORE_FLOOR=20
STOCH_RSI_SCORE_CEIL=80
VOLUME_SCORE_SCALE=50
VOLATILITY_LOW_MAX_PCT=0.5
VOLATILITY_HIGH_MIN_PCT=5.0
VOLATILITY_SCORE_EXTREME=40
RISK_RESISTANCE_DISTANCE_FOR_MAX_SCORE=5.0
# Evidence-only 5-way volatility bucket (learning_statistics), 2 extra
# boundaries around the live-scoring pair above.
VOLATILITY_VERY_LOW_MAX_PCT=0.2
VOLATILITY_EXTREME_MIN_PCT=10.0
OPPORTUNITY_WEIGHT_TREND=0.30
OPPORTUNITY_WEIGHT_MOMENTUM=0.25
OPPORTUNITY_WEIGHT_VOLUME=0.15
OPPORTUNITY_WEIGHT_VOLATILITY=0.15
OPPORTUNITY_WEIGHT_RISK=0.15
TOP_N_CANDIDATES=5
MIN_OPPORTUNITY_SCORE=60
EXIT_SCORE_THRESHOLD=40

# Market regime classification, see PROJECT_SPEC.md §3a
REGIME_ADX_TREND_THRESHOLD=20
REGIME_STRONG_TREND_SCORE_MIN=75

# Trade Memory / Learning Engine (see PROJECT_SPEC.md §3a) — all
# optional, these are the defaults.
LEARNING_HISTORY_WINDOW_DAYS=180
LEARNING_CATCHUP_LOOKBACK_HOURS=72
MAX_SIMILAR_TRADES_SCANNED=500
MIN_SIMILAR_TRADES=5
SIMILARITY_TOP_N=10
SIMILARITY_MAX_DISTANCE=30
SORTINO_MAR_PCT=0
CONFIDENCE_AI_WEIGHT=0.6
CONFIDENCE_HISTORICAL_WEIGHT=0.4
MIN_FINAL_CONFIDENCE=0
CONFIDENCE_ACCURACY_MIDPOINT=50
OPPORTUNITY_SCORE_BUCKET_WIDTH=10
CONFIDENCE_BUCKET_WIDTH=10
RECOMMENDATION_MIN_IMPROVEMENT_PCT=15
RECOMMENDATION_MIN_SAMPLE_SIZE=20
MIN_EXPECTANCY_DELTA=1.0

# Adaptive Strategy Intelligence Engine (see PROJECT_SPEC.md §3b) — all
# optional, these are the defaults. Advisory only; nothing here is
# auto-applied to live trading except the confidence-modifier chain,
# which extends the already-automatic (and inert-by-default) confidence
# calibration gate above.
ADAPTIVE_TRAIN_TEST_SPLIT_PCT=0.7
SIGNIFICANCE_THRESHOLD=0.05
BUCKET_MODIFIER_SENSITIVITY=20
BUCKET_MODIFIER_CAP=10
RECENT_PERFORMANCE_LOOKBACK_TRADES=10
RECENT_STREAK_WIN_MODIFIER_CAP=5
RECENT_STREAK_LOSS_MODIFIER_CAP=15

# Event-Driven Backtesting & Walk-Forward Validation Engine (see
# PROJECT_SPEC.md §3c) — all optional, these are the defaults. On-demand
# CLI only (python -m src.backtest.engine / ingest_data), not a cron job.
BACKTEST_TICK_TIMEFRAME=1m
BACKTEST_DECISION_CYCLE_MINUTES=10
BACKTEST_RISK_CHECK_MINUTES=5
BACKTEST_WARMUP_BUFFER_DAYS=260
BACKTEST_STARTING_CAPITAL=100000
BACKTEST_POSITION_SIZE_PCT=10
BACKTEST_MAX_CONCURRENT_POSITIONS=5
BACKTEST_SLIPPAGE_BPS=5
BACKTEST_SPREAD_BPS=10
BACKTEST_MAX_FILL_PCT_OF_BAR_VOLUME=10
BACKTEST_ORDER_EXPIRY_BARS=20
BACKTEST_MIN_NOTIONAL_INR=100
BACKTEST_RANDOM_SEED=42
BACKTEST_BOOTSTRAP_ITERATIONS=1000
BACKTEST_MONTE_CARLO_ITERATIONS=1000
BACKTEST_WALK_FORWARD_N_FOLDS=5
BACKTEST_WALK_FORWARD_TRAIN_DAYS=90
BACKTEST_WALK_FORWARD_TEST_DAYS=30
BACKTEST_CANDLE_PAGE_SIZE=500

# Institutional Reliability Layer (see PROJECT_SPEC.md §3d) — all optional,
# these are the defaults. sizing_mode ('flat'/'dynamic') and
# strategy_versions.status ('active'/'suspended') are DB columns, not env
# vars — a human flips those directly in Supabase; nothing below changes
# live trading until that happens.

# Market Data Quality Engine + Data Repair Engine
DATA_QUALITY_SEVERITY_MISSING_CANDLE=warn
DATA_QUALITY_SEVERITY_DUPLICATE=warn
DATA_QUALITY_SEVERITY_NEGATIVE_PRICE=reject
DATA_QUALITY_SEVERITY_INVALID_OHLC=reject
DATA_QUALITY_SEVERITY_OUT_OF_ORDER=warn
DATA_QUALITY_SEVERITY_TIMESTAMP_GAP=warn
DATA_QUALITY_SEVERITY_ZERO_VOLUME=warn
DATA_QUALITY_SEVERITY_PRICE_SPIKE=warn
DATA_QUALITY_SEVERITY_EXCHANGE_OUTAGE=reject
DATA_QUALITY_SEVERITY_CLOCK_DRIFT=warn
DATA_QUALITY_SEVERITY_SYMBOL_MISMATCH=reject
DATA_QUALITY_SEVERITY_TIMEFRAME_CHANGE=warn
DATA_QUALITY_PRICE_SPIKE_PCT_THRESHOLD=20
DATA_QUALITY_CLOCK_DRIFT_SECONDS_THRESHOLD=300
DATA_REPAIR_MAX_GAP_BARS=3

# Portfolio Intelligence Engine
COIN_CATEGORY_MAP=
PORTFOLIO_VAR_CONFIDENCE_PCT=95
PORTFOLIO_CORRELATION_LOOKBACK_BARS=30
PORTFOLIO_BETA_PROXY_SYMBOL=BTCINR
MAX_POSITION_CONCENTRATION_MULT_OF_EQUAL_SHARE=2.0
MAX_SECTOR_CONCENTRATION_MULT_OF_EQUAL_SHARE=2.5

# Capital Allocation Engine — only reached when a mode's capital_config.
# sizing_mode='dynamic' (DB default is 'flat', unchanged behavior)
CAPITAL_ALLOC_CORRELATION_MIN_MULT=0.5
CAPITAL_ALLOC_CORRELATION_MAX_MULT=1.5
CAPITAL_ALLOC_VOLATILITY_MIN_MULT=0.5
CAPITAL_ALLOC_VOLATILITY_MAX_MULT=1.5
CAPITAL_ALLOC_DRAWDOWN_MIN_MULT=0.5
CAPITAL_ALLOC_DRAWDOWN_MAX_MULT=1.5
CAPITAL_ALLOC_EXPOSURE_MIN_MULT=0.5
CAPITAL_ALLOC_EXPOSURE_MAX_MULT=1.5
CAPITAL_ALLOC_STRATEGY_PERFORMANCE_MIN_MULT=0.5
CAPITAL_ALLOC_STRATEGY_PERFORMANCE_MAX_MULT=1.5
CAPITAL_ALLOC_REGIME_MIN_MULT=0.5
CAPITAL_ALLOC_REGIME_MAX_MULT=1.5
CAPITAL_ALLOC_CONFIDENCE_MIN_MULT=0.5
CAPITAL_ALLOC_CONFIDENCE_MAX_MULT=1.5
CAPITAL_ALLOC_TOTAL_MIN_MULT=0.5
CAPITAL_ALLOC_TOTAL_MAX_MULT=1.5

# Fees — CoinDCX spot trading fee + GST on that fee + sell-side TDS
# (Income Tax Act s.194S). Shared by paper and real execution.
TRADING_FEE_PCT=0.5
GST_PCT_ON_FEE=18
SELL_TDS_PCT=1
SLIPPAGE_BPS=5
# Synthetic spread cost for the live Net Expectancy Gate — live has no
# real order-book data any more than backtest does.
EXPECTANCY_SPREAD_BPS=10

# Net Expectancy Gate + Risk-Based Sizing + ATR stop-loss fallback
# (src/agents/risk_manager.py). RISK_PER_TRADE_PCT: max % of capital_to_use
# risked per trade if the stop is hit (additional cap on top of the
# existing flat/dynamic position sizing, never a replacement).
# STOP_LOSS_ATR_MULTIPLIER/TAKE_PROFIT_ATR_MULTIPLIER: fallback stop/target
# distance (as a multiple of atr_pct) used ONLY when a strategy version's
# params_json doesn't configure that leg — the evidence-validated
# params_json value always wins when present.
RISK_PER_TRADE_PCT=1.0
STOP_LOSS_ATR_MULTIPLIER=1.5
TAKE_PROFIT_ATR_MULTIPLIER=3.0
# net_expectancy_pct <= 0 always blocks real mode. Paper mode risks
# nothing real, so by default it trades through a negative net expectancy
# too -- otherwise it can never accumulate the trade history calibration/
# promotion need. Set false to make paper as strict as real.
PAPER_TRADES_ON_NEGATIVE_EXPECTANCY=true

# Strategy Profiles (multi-strategy-type support, src/config.py
# STRATEGY_PROFILES) — "default" reuses the vars above unchanged. "swing" is
# a longer-horizon profile, inert until its capital_config row is seeded
# (python3 -m src.seed_config, strategy_type=swing) — a strategy_type with no
# capital_config row never runs. Every var below has a sane built-in
# fallback; only set what you want to override.
SWING_TIMEFRAME_WEIGHTS=1h:0.35,1d:0.65
SWING_OPPORTUNITY_WEIGHT_TREND=0.30
SWING_OPPORTUNITY_WEIGHT_MOMENTUM=0.25
SWING_OPPORTUNITY_WEIGHT_VOLUME=0.15
SWING_OPPORTUNITY_WEIGHT_VOLATILITY=0.15
SWING_OPPORTUNITY_WEIGHT_RISK=0.15
SWING_MIN_OPPORTUNITY_SCORE=60
SWING_TOP_N_CANDIDATES=5
SWING_EXIT_SCORE_THRESHOLD=25
SWING_STOP_LOSS_ATR_MULTIPLIER=3.0
SWING_TAKE_PROFIT_ATR_MULTIPLIER=6.0
SWING_EXIT_PARAM_SWEEP_MIN_PCT=0.01
SWING_EXIT_PARAM_SWEEP_MAX_PCT=0.20
SWING_RISK_PER_TRADE_PCT=1.0

# Execution Optimizer — off by default; only PaperExecutionAgent can act on
# a recommendation (RealExecutionAgent stays market-only regardless)
EXECUTION_OPTIMIZER_ENABLED=false
EXECUTION_OPTIMIZER_SPREAD_BPS_LIMIT_THRESHOLD=15
EXECUTION_OPTIMIZER_MIN_FILL_PROBABILITY=0.7

# Feature Drift Detection
DRIFT_BASELINE_WINDOW_DAYS=90
DRIFT_RECENT_WINDOW_DAYS=14
DRIFT_PSI_WARNING_THRESHOLD=0.1
DRIFT_PSI_CRITICAL_THRESHOLD=0.25
DRIFT_PSI_BUCKET_COUNT=10

# Strategy Health Engine
STRATEGY_HEALTH_EXCELLENT_THRESHOLD=80
STRATEGY_HEALTH_GOOD_THRESHOLD=60
STRATEGY_HEALTH_WARNING_THRESHOLD=40
STRATEGY_HEALTH_AUTO_SUSPEND_ENABLED=true

# Production Monitoring & Self-Diagnostics
SYSTEM_METRICS_MARKET_FEED_STALE_MINUTES=30
SYSTEM_METRICS_LEARNING_STALE_HOURS=48

# Resilience
RETRY_MAX_ATTEMPTS=3
RETRY_BASE_DELAY_SECONDS=1
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_COOLDOWN_SECONDS=300

# Data Retention — purge_old_data(), hourly via evolution_agent.run_evolution().
# Learning-relevant tables (opportunity_evaluations/confidence_calibration)
# reuse LEARNING_HISTORY_WINDOW_DAYS above instead of a second constant.
OPERATIONAL_LOG_RETENTION_DAYS=30

# Scientific Strategy Optimization — fitness score (default blend: 30%
# profit factor / 25% Sharpe / 20% expectancy / 15% win rate / 10%
# drawdown penalty), promotion eligibility gate, exit-param candidate sweep
FITNESS_WEIGHT_PROFIT_FACTOR=0.30
FITNESS_WEIGHT_SHARPE=0.25
FITNESS_WEIGHT_EXPECTANCY=0.20
FITNESS_WEIGHT_WIN_RATE=0.15
FITNESS_WEIGHT_DRAWDOWN_PENALTY=0.10
FITNESS_EXPECTANCY_SCALE=10
PROMOTION_MIN_FITNESS_SCORE=60
EXIT_PARAM_SWEEP_MIN_PCT=0.01
EXIT_PARAM_SWEEP_MAX_PCT=0.10
EXIT_PARAM_SWEEP_STEP_PCT=0.01

# Progressive Learning Stages — trade-count boundaries unlocking each layer
# of the learning engine (weakness reports / feature importance / hypotheses
# (recommendations) / simulation / candidate-strategy creation)
LEARNING_STAGE_OBSERVATION_MIN_TRADES=25
LEARNING_FEATURE_IMPORTANCE_MIN_TRADES=50
LEARNING_STAGE_HYPOTHESIS_MIN_TRADES=100
LEARNING_STAGE_SIMULATION_MIN_TRADES=250
LEARNING_STAGE_VALIDATION_MIN_TRADES=500

# Evidence Engine — evidence-readiness blend weights (renormalized among
# available components) and coverage targets driving the BOOTSTRAP->
# OBSERVATION transition only; deeper stages stay trade-count gated above.
EVIDENCE_WEIGHT_TRADE_COVERAGE=0.25
EVIDENCE_WEIGHT_MARKET_COVERAGE=0.15
EVIDENCE_WEIGHT_SYMBOL_COVERAGE=0.15
EVIDENCE_WEIGHT_FEATURE_COVERAGE=0.15
EVIDENCE_WEIGHT_SESSION_COVERAGE=0.10
EVIDENCE_WEIGHT_CONFIDENCE_COVERAGE=0.10
EVIDENCE_WEIGHT_REJECTION_EVIDENCE=0.10
EVIDENCE_SYMBOL_COVERAGE_TARGET=20
EVIDENCE_REJECTED_COVERAGE_TARGET=500
EVIDENCE_HOURS_OBSERVATION_MIN_TRADES=25
EVIDENCE_REGIMES_OBSERVATION_MIN=6
EVIDENCE_FEATURE_COVERAGE_OBSERVATION_MIN_PCT=80
EVIDENCE_READINESS_OBSERVATION_MIN_PCT=40
