# LLM provider: "groq" (default) or "ollama" (Ollama Cloud, not local)
LLM_PROVIDER=groq

# Groq
GROQ_API_KEY=
GROQ_MODEL_CHAIN=openai/gpt-oss-120b,qwen/qwen3.6-27b

# Ollama Cloud — only used when LLM_PROVIDER=ollama. Get a key at
# https://ollama.com/settings/keys. Model names from
# https://ollama.com/search?c=cloud — no "-cloud" suffix here: that
# suffix is only for routing through a local Ollama daemon, not this
# direct-to-ollama.com setup (see https://docs.ollama.com/cloud#python).
OLLAMA_API_KEY=
OLLAMA_BASE_URL=https://ollama.com
OLLAMA_MODEL_CHAIN=gpt-oss:120b

# CoinDCX
COINDCX_API_KEY=
COINDCX_API_SECRET=

# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_ANON_KEY=

# Promotion criteria (paper -> real), see PROJECT_SPEC.md §2
PROMOTION_MIN_PAPER_DAYS=14
PROMOTION_MIN_CUMULATIVE_PNL=0
PROMOTION_MAX_DRAWDOWN_PCT=15

# Feature Engine / Opportunity Scorer (quant-first pipeline, see
# PROJECT_SPEC.md §3) — all optional, these are the defaults.
TIMEFRAME_WEIGHTS=5m:0.15,15m:0.25,1h:0.30,4h:0.30
FEATURE_CANDLE_LIMIT=250
RSI_PERIOD=14
MACD_FAST=12
MACD_SLOW=26
MACD_SIGNAL=9
STOCH_RSI_PERIOD=14
STOCH_K_SMOOTH=3
STOCH_D_SMOOTH=3
ATR_PERIOD=14
BOLLINGER_PERIOD=20
BOLLINGER_NUM_STD=2
RELATIVE_VOLUME_LOOKBACK=20
VOLUME_SPIKE_THRESHOLD=2.0
OBV_SLOPE_LOOKBACK=5
SUPPORT_RESISTANCE_LOOKBACK=50
ADX_PERIOD=14
EMA_TREND_PERIOD_1=20
EMA_TREND_PERIOD_2=50
EMA_TREND_PERIOD_3=100
EMA_TREND_PERIOD_4=200
RSI_SCORE_FLOOR=30
RSI_SCORE_CEIL=70
STOCH_RSI_SCORE_FLOOR=20
STOCH_RSI_SCORE_CEIL=80
VOLUME_SCORE_SCALE=50
VOLATILITY_LOW_MAX_PCT=0.5
VOLATILITY_HIGH_MIN_PCT=5.0
VOLATILITY_SCORE_EXTREME=40
RISK_RESISTANCE_DISTANCE_FOR_MAX_SCORE=5.0
OPPORTUNITY_WEIGHT_TREND=0.30
OPPORTUNITY_WEIGHT_MOMENTUM=0.25
OPPORTUNITY_WEIGHT_VOLUME=0.15
OPPORTUNITY_WEIGHT_VOLATILITY=0.15
OPPORTUNITY_WEIGHT_RISK=0.15
TOP_N_CANDIDATES=5
MIN_OPPORTUNITY_SCORE=60
EXIT_SCORE_THRESHOLD=40
