# LLM provider: "groq" (default) or "ollama" (Ollama Cloud, not local)
LLM_PROVIDER=groq

# Groq
GROQ_API_KEY=
GROQ_MODEL_CHAIN=openai/gpt-oss-120b,qwen/qwen3.6-27b

# Ollama Cloud — only used when LLM_PROVIDER=ollama. Get a key at
# https://ollama.com/settings/keys. Model names from
# https://ollama.com/search?c=cloud — no "-cloud" suffix here: that
# suffix is only for routing through a local Ollama daemon, not this
# direct-to-ollama.com setup (see https://docs.ollama.com/cloud#python).
OLLAMA_API_KEY=
OLLAMA_BASE_URL=https://ollama.com
OLLAMA_MODEL_CHAIN=gpt-oss:120b

# CoinDCX
COINDCX_API_KEY=
COINDCX_API_SECRET=

# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_ANON_KEY=

# Promotion criteria (paper -> real), see PROJECT_SPEC.md §2
PROMOTION_MIN_PAPER_DAYS=14
PROMOTION_MIN_CUMULATIVE_PNL=0
PROMOTION_MAX_DRAWDOWN_PCT=15

# Feature Engine / Opportunity Scorer (quant-first pipeline, see
# PROJECT_SPEC.md §3) — all optional, these are the defaults.
TIMEFRAME_WEIGHTS=1m:0.15,15m:0.25,1h:0.30,1d:0.30
FEATURE_CANDLE_LIMIT=250
RSI_PERIOD=14
MACD_FAST=12
MACD_SLOW=26
MACD_SIGNAL=9
STOCH_RSI_PERIOD=14
STOCH_K_SMOOTH=3
STOCH_D_SMOOTH=3
ATR_PERIOD=14
BOLLINGER_PERIOD=20
BOLLINGER_NUM_STD=2
RELATIVE_VOLUME_LOOKBACK=20
VOLUME_SPIKE_THRESHOLD=2.0
OBV_SLOPE_LOOKBACK=5
SUPPORT_RESISTANCE_LOOKBACK=50
ADX_PERIOD=14
EMA_TREND_PERIOD_1=20
EMA_TREND_PERIOD_2=50
EMA_TREND_PERIOD_3=100
EMA_TREND_PERIOD_4=200
RSI_SCORE_FLOOR=30
RSI_SCORE_CEIL=70
STOCH_RSI_SCORE_FLOOR=20
STOCH_RSI_SCORE_CEIL=80
VOLUME_SCORE_SCALE=50
VOLATILITY_LOW_MAX_PCT=0.5
VOLATILITY_HIGH_MIN_PCT=5.0
VOLATILITY_SCORE_EXTREME=40
RISK_RESISTANCE_DISTANCE_FOR_MAX_SCORE=5.0
OPPORTUNITY_WEIGHT_TREND=0.30
OPPORTUNITY_WEIGHT_MOMENTUM=0.25
OPPORTUNITY_WEIGHT_VOLUME=0.15
OPPORTUNITY_WEIGHT_VOLATILITY=0.15
OPPORTUNITY_WEIGHT_RISK=0.15
TOP_N_CANDIDATES=5
MIN_OPPORTUNITY_SCORE=60
EXIT_SCORE_THRESHOLD=40

# Market regime classification, see PROJECT_SPEC.md §3a
REGIME_ADX_TREND_THRESHOLD=20
REGIME_STRONG_TREND_SCORE_MIN=75

# Trade Memory / Learning Engine (see PROJECT_SPEC.md §3a) — all
# optional, these are the defaults.
LEARNING_HISTORY_WINDOW_DAYS=180
LEARNING_CATCHUP_LOOKBACK_HOURS=72
MAX_SIMILAR_TRADES_SCANNED=500
MIN_SIMILAR_TRADES=5
SIMILARITY_TOP_N=10
SIMILARITY_MAX_DISTANCE=30
SORTINO_MAR_PCT=0
CONFIDENCE_AI_WEIGHT=0.6
CONFIDENCE_HISTORICAL_WEIGHT=0.4
MIN_FINAL_CONFIDENCE=0
CONFIDENCE_ACCURACY_MIDPOINT=50
OPPORTUNITY_SCORE_BUCKET_WIDTH=10
CONFIDENCE_BUCKET_WIDTH=10
RECOMMENDATION_MIN_IMPROVEMENT_PCT=15
RECOMMENDATION_MIN_SAMPLE_SIZE=20
MIN_EXPECTANCY_DELTA=1.0

# Adaptive Strategy Intelligence Engine (see PROJECT_SPEC.md §3b) — all
# optional, these are the defaults. Advisory only; nothing here is
# auto-applied to live trading except the confidence-modifier chain,
# which extends the already-automatic (and inert-by-default) confidence
# calibration gate above.
ADAPTIVE_TRAIN_TEST_SPLIT_PCT=0.7
SIGNIFICANCE_THRESHOLD=0.05
BUCKET_MODIFIER_SENSITIVITY=20
BUCKET_MODIFIER_CAP=10
RECENT_PERFORMANCE_LOOKBACK_TRADES=10
RECENT_STREAK_WIN_MODIFIER_CAP=5
RECENT_STREAK_LOSS_MODIFIER_CAP=15

# Event-Driven Backtesting & Walk-Forward Validation Engine (see
# PROJECT_SPEC.md §3c) — all optional, these are the defaults. On-demand
# CLI only (python -m src.backtest.engine / ingest_data), not a cron job.
BACKTEST_TICK_TIMEFRAME=1m
BACKTEST_DECISION_CYCLE_MINUTES=10
BACKTEST_RISK_CHECK_MINUTES=5
BACKTEST_WARMUP_BUFFER_DAYS=260
BACKTEST_STARTING_CAPITAL=100000
BACKTEST_POSITION_SIZE_PCT=10
BACKTEST_MAX_CONCURRENT_POSITIONS=5
BACKTEST_SLIPPAGE_BPS=5
BACKTEST_SPREAD_BPS=10
BACKTEST_MAX_FILL_PCT_OF_BAR_VOLUME=10
BACKTEST_FILL_DELAY_BARS=0
BACKTEST_ORDER_EXPIRY_BARS=20
BACKTEST_MAX_RETRY_ATTEMPTS=3
BACKTEST_MIN_NOTIONAL_INR=100
BACKTEST_RANDOM_SEED=42
BACKTEST_BOOTSTRAP_ITERATIONS=1000
BACKTEST_MONTE_CARLO_ITERATIONS=1000
BACKTEST_WALK_FORWARD_N_FOLDS=5
BACKTEST_WALK_FORWARD_TRAIN_DAYS=90
BACKTEST_WALK_FORWARD_TEST_DAYS=30
BACKTEST_USE_LLM_SIGNAL_AGENT=false
BACKTEST_CANDLE_PAGE_SIZE=500
